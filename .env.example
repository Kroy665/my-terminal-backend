# Server Configuration
NODE_ENV=development
PORT=6060

# Database Configuration (PostgreSQL)
DATABASE_URL=postgresql://user:password@localhost:5432/mobile_code_editor

# JWT Configuration
JWT_SECRET=your-super-secret-key-change-this-in-production
JWT_EXPIRY=7d
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-this
JWT_REFRESH_EXPIRY=30d

# E2B Configuration (for code execution)
E2B_API_KEY=your-e2b-api-key
E2B_TIMEOUT=30000

# Sandbox Configuration
SANDBOX_MAX_PER_USER=5
SANDBOX_DEFAULT_TTL=3600
SANDBOX_MAX_TTL=86400
SANDBOX_CLEANUP_INTERVAL=60000

# CORS Configuration
CORS_ORIGIN=http://localhost:8081,http://localhost:3000

# Rate Limiting
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info

# Security
BCRYPT_ROUNDS=10
